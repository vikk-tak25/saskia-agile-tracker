{
  "name": "saskia-agile-tracker",
  "version": "1.0.0",
  "description": "Agile Tracker for managing user stories on a Kanban board.",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/api.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "supertest": "^7.2.2",
    "vite": "^7.1.12"
  }
}
